{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultron",
  "version": "0.1.0",
  "identifier": "dev.ultron.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ultron/desktop exec vite",
    "beforeBuildCommand": "pnpm --filter @ultron/desktop exec vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ultron",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4577 ws://127.0.0.1:4577"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
